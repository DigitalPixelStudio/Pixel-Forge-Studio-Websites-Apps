# =============================================================================
# Pixel Forge Studio - .gitignore (merged)
# =============================================================================

# --- Operating system files ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyc

# --- Virtual environments ---
venv/
ENV/
env/
.venv/

# --- IDEs and editors ---
.vscode/
.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln

# --- Language-agnostic build / output artifacts ---
build/
dist/
out/
bin/
target/
*.o
*.obj
*.exe
*.dll
*.dylib
*.a
*.lib
*.class
*.jar
*.war
*.ear

# --- Python packaging ---
*.egg-info/
*.egg
.develop-eggs/
.installed.cfg
parts/
var/
sdist/
downloads/
eggs/
.eggs/

# --- Logs and temporary files ---
*.log
*.tmp
*.temp
*.cache
tmp/
temp/

# --- Environment and secrets ---
.env
.env.local
.env.*.local
*.env
secrets/
credentials/
*.key
*.pem
*.p12
*.jks

# --- Package manager artifacts ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
composer.lock
poetry.lock
Pipfile.lock
Gemfile.lock

# --- Next.js ---
.next/
out/
*.tsbuildinfo

# --- OS-generated thumbnail / metadata ---
._*

# --- Portable Git installation (do not version control binaries) ---
Git/

# =============================================================================
# End of .gitignore
# =============================================================================
